<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The camera is used for exactly one thing: reading the QR a service
         shows when enrolling. `mobile_scanner` needs it declared. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Not required: the app must stay installable on a device without a
         camera, where the setup link and manual entry still work. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- No cloud backup, no device-to-device transfer (H7, item 6).
         `allowBackup="false"` alone is not enough on Android 12+, where the
         platform can still copy app data to a new phone; `dataExtractionRules`
         is the rule set that actually governs both cloud backup and transfer,
         and the two XML files below exclude everything it covers. The stored
         account blob is encrypted by the Keystore, so a copy would be useless
         without the device key — but "useless ciphertext uploaded to someone
         else's cloud" is not a posture worth having, and the user has an
         export path that asks for a passphrase and biometrics first. -->
    <!-- The app is 100% offline (ADR-0016). Declaring no INTERNET permission
         is stronger than promising not to use the network: Android enforces
         it, and a dependency that tries to phone home fails rather than
         silently succeeding.

         Both have to be *removed*, not merely omitted: `mobile_scanner` pulls
         in Google's ML Kit, which drags `transport-backend-cct` along, and
         that library adds `INTERNET` and `ACCESS_NETWORK_STATE` in its own
         manifest for telemetry. Without these lines the merged release
         manifest declares network access and a security product's
         authenticator would be free to upload whatever a transitive
         dependency decides to. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <application
        android:label="BandAll Authenticator"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
